# Copia a .env y rellena. NUNCA commitees .env
# Wallet quemable de hackaton. Sin el 0x inicial no funciona.
PRIVATE_KEY=0x...

# RPC de Avalanche Fuji (C-Chain). El publico funciona bien para el hackaton.
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Se rellenan despues del deploy, para el script de seed
CONTRACT_ADDRESS=
PROPIETARIO_DEMO=

# Nota: la verificacion en Snowtrace/Routescan NO necesita API key.
# Ya esta configurada en foundry.toml.
