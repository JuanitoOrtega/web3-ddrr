# Copia a .env y rellena. NUNCA commitees .env
# Wallet quemable de hackaton. Sin el 0x inicial no funciona.
PRIVATE_KEY=0x...

# RPC de Base Sepolia (Alchemy, QuickNode, o el publico https://sepolia.base.org)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Para `--verify` en Basescan
BASESCAN_API_KEY=

# Se rellenan despues del deploy, para el script de seed
CONTRACT_ADDRESS=
PROPIETARIO_DEMO=
