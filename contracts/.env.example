# Copia a .env y rellena. NUNCA commitees .env

# --- Wallet A: notario, deployer y owner del contrato ---
# Metamask exporta la clave SIN "0x". Tienes que ponérselo delante.
PRIVATE_KEY=0x...

# Red
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# --- Duenos de los titulos sembrados ---
# Wallet A: se queda con 4 de las 5 propiedades.
PROPIETARIO_DEMO=
# Wallet B (tu companera): dueña de la de Equipetrol, la que intenta vender
# por fuera en la demo. Necesita algo de AVAX para poder intentarlo.
PROPIETARIO_B=

# Se rellena tras el deploy
CONTRACT_ADDRESS=

# La verificacion en Snowtrace/Routescan no necesita API key.
